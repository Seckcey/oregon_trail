{
  "name": "eight-west-trail",
  "private": true,
  "version": "0.1.0",
  "description": "The 8 West Trail — a road-trip survival game from 8 West IT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "art": "node scripts/optimize-art.mjs",
    "shared": "vite-node scripts/write-shared.ts",
    "test:server": "npm --prefix server test",
    "test:all": "npm test && npm run test:server"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.3.0",
    "sharp": "^0.35.3",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
